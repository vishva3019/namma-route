# NammaRoute Environment Configuration Template
# Copy this to .env and configure for your deployment

# Database Configuration (PostgreSQL in production, or SQLite in dev)
# For PostgreSQL (Docker / Neon / Supabase / Railway):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nammaroute?schema=public"
# For zero-dependency local SQLite development:
# DATABASE_URL="file:./dev.db"

# Redis Caching (Optional: falls back to high-performance in-memory cache if omitted)
REDIS_URL="redis://localhost:6379"

# Realtime Provider ('bmtc' for live BMTC network, 'mock' for simulated Bangalore corridor fleet)
REALTIME_PROVIDER="bmtc"

# Polling interval in seconds (Default 30s. Never poll per second)
REALTIME_POLL_INTERVAL=30

# BMTC Mobile Gateway Base URL (Community researched endpoint)
BMTC_API_BASE_URL="https://bmtcmobileapi.karnataka.gov.in/WebAPI"
BMTC_API_KEY=""

# Static GTFS Source
GTFS_SOURCE_URL="https://raw.githubusercontent.com/Vonter/bmtc-gtfs/main/gtfs/bmtc.zip"

# Cache TTL in seconds for vehicle updates
CACHE_TTL=30

# Node Environment
NODE_ENV="development"

# Server Port
PORT=4000

# Demo Mode
# When true: runs simulation on genuine BMTC routes and displays prominent 'DEMO MODE' badge
# When false: connects directly to configured BMTC live provider
DEMO_MODE=false

# Allowed Frontend Origin
FRONTEND_URL="http://localhost:5173"
